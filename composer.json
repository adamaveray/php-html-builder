{
  "name": "averay/html-builder",
  "type": "library",
  "description": "Utilities for building HTML.",
  "license": "MIT",
  "homepage": "https://github.com/adamaveray/php-html-builder",
  "authors": [
    {
      "name": "Adam Averay",
      "homepage": "https://adamaveray.au/"
    }
  ],
  "autoload": {
    "psr-4": {
      "Averay\\HtmlBuilder\\": "src/"
    },
    "files": [
      "src/Css/lib.php",
      "src/Html/lib.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Averay\\HtmlBuilder\\Tests\\": "tests/"
    },
    "files": [
      "node_modules/@averay/codeformat/autoload.php"
    ]
  },
  "require": {
    "php": ">=8.5",
    "fig/http-message-util": "^1.1",
    "league/uri": "^7.8",
    "symfony/mime": "^8.1"
  },
  "require-dev": {
    "carthage-software/mago": "^1.51",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpunit/phpunit": "^13.3",
    "roave/security-advisories": "dev-latest",
    "twig/html-extra": "^3.29"
  }
}
